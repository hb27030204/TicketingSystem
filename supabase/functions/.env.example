# Copy to supabase/functions/.env for local `supabase functions serve`.
# In production, set these with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# by the Supabase runtime and should NOT be set here.

# Public URL this app is deployed at. Used to build the /checkin QR link
# and the /ticket/<booking_code> link.
SITE_URL=https://your-app.vercel.app

# Razorpay (Settings -> API Keys in the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# MSG91 (https://control.msg91.com -> API keys). Account-wide auth key.
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# MSG91 SMTP relay for OTP emails - from the MSG91 dashboard, Domain
# Settings -> SMTP, once your domain is verified there and SMTP is
# toggled on for it. Referenced by supabase/config.toml's
# [auth.email.smtp] block via env(...).
MSG91_SMTP_USER=xxxxxxxxxxxxxxxxxxxxxxxx
MSG91_SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxx

# MSG91 templated Email API, for the ticket-link email
# (send-ticket-email). `domain` and `template_id` come from the account's
# real integration snippet shown in the MSG91 dashboard for the created
# template - don't guess these, they're account-specific.
MSG91_TICKET_EMAIL_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
MSG91_TICKET_EMAIL_DOMAIN=xxxxxxxxxxxxxxxxxxxxxxxx
MSG91_TICKET_EMAIL_FROM=tickets@your-domain.tld
