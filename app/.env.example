# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Razorpay publishable key ID only (never put the key SECRET in the frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# MSG91 OTP Widget settings page - safe to expose client-side (that's
# the documented point of the widget token, distinct from the
# account-wide MSG91_AUTH_KEY which stays a backend-only secret)
VITE_MSG91_WIDGET_ID=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_MSG91_WIDGET_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
